<article
  class="notiz notiz--<%= eintrag.bildIndex %>"
  role="listitem"
  data-id="<%= eintrag.id %>"
  style="
    --drehung: <%= drehung %>deg;
    --bild: url('<%= eintrag.image %>');
    --aspect: <%= eintrag.aspect %>;
    --schrift: <%= eintrag.schriftFaktor %>cqw;
    --text-links: <%= eintrag.textBereich.links %>;
    --text-rechts: <%= eintrag.textBereich.rechts %>;
    --text-oben: <%= eintrag.textBereich.oben %>;
    --text-unten: <%= eintrag.textBereich.unten %>;
    left: <%= x %>%;
    top: <%= y %>%;
  "
>
  <div class="notiz-text-bereich">
    <p class="notiz-text"><span class="notiz-text-inhalt"><%= eintrag.text %></span></p>
  </div>

  <div class="notiz-meta">
    <time datetime="<%= eintrag.createdAt %>">
      <%= new Date(eintrag.createdAt).toLocaleDateString('de-DE', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
      }) %>
    </time>
  </div>

  <%# Das angehängte Bild hängt am Rand des Blattes %>
  <% if (eintrag.bild) { %>
  <figure class="notiz-foto" style="--foto-breite: <%= eintrag.fotoBreite %>%">
    <img
      class="notiz-foto-bild"
      src="<%= eintrag.bild %>"
      alt="Zum Wunsch gehörendes Bild"
      loading="lazy"
      decoding="async"
    />
    <span class="notiz-foto-band" aria-hidden="true"></span>
  </figure>
  <% } %>
</article>
