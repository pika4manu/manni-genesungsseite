<dialog class="dialog" id="wunsch-dialog" aria-labelledby="dialog-titel">
  <form class="dialog-formular" method="post" action="/wuensche">
    <h2 class="dialog-titel" id="dialog-titel">Neuer Genesungswunsch</h2>
    <p class="dialog-text">
      Schreib einen Wunsch für Herrn Gerstgrasser – er wird sofort auf ein Blatt
      geschrieben und an die Pinnwand gehängt.
    </p>

    <% if (fehler) { %>
      <p class="hinweis hinweis-fehler" role="alert">
        <% if (fehler === 'leer') { %>
          Bitte schreibe zuerst einen Wunsch auf.
        <% } else if (fehler === 'zu-lang') { %>
          Der Wunsch ist zu lang. Maximal 600 Zeichen sind erlaubt.
        <% } else if (fehler === 'zu-schnell') { %>
          Bitte kurz warten – du kannst deinen Wunsch gleich noch einmal anhängen.
        <% } else { %>
          Der Wunsch konnte nicht gespeichert werden. Bitte versuche es noch einmal.
        <% } %>
      </p>
    <% } %>

    <%- include('formular.ejs', {
      eintraege: eintraege,
      textVorbelegt: textVorbelegt
    }) %>

    <div class="dialog-aktionen">
      <button class="knoepf knoepf-neutral" type="button" data-dialog-schliessen="wunsch-dialog">
        Abbrechen
      </button>
      <button class="knoepf" type="submit">An die Pinnwand hängen</button>
    </div>
  </form>
</dialog>
