<dialog class="dialog dialog-posit" id="posit-dialog" aria-labelledby="posit-titel">
  <div class="dialog-formular">
    <h2 class="dialog-titel" id="posit-titel">Der Wunsch in Ruhe</h2>
    <p class="dialog-text">So steht der Wunsch auf dem Blatt:</p>

    <div class="posit-blatt">
      <div class="notiz-text-bereich">
        <p class="notiz-text"><span class="notiz-text-inhalt"></span></p>
      </div>
      <div class="posit-foto-slot"></div>
    </div>

    <div class="dialog-aktionen">
      <button class="knoepf" type="button" data-dialog-schliessen="posit-dialog">
        Schließen
      </button>
    </div>
  </div>
</dialog>
