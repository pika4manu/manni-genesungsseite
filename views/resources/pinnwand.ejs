<%
  const gesamt = eintraege.length;
  const spalten = Math.max(1, Math.min(6, Math.ceil(Math.sqrt(gesamt * 1.7))));
  const zeilen = Math.max(1, Math.ceil(gesamt / spalten));
  const drehungen = [-3, 2.5, -1.5, 4, -4.5, 1.5, 3.5, -2.5, 2, -3.5];
  const streuung = (i) => (((i * 37) % 13) - 6) / 100;
  const zeilenHoehe = 300;
%>
<div class="pinnwand" style="--board-hoehe: <%= zeilen * zeilenHoehe + 70 %>px;" role="list">
  <% eintraege.forEach(function (eintrag, index) { %>
    <%
      const spalte = index % spalten;
      const zeile = Math.floor(index / spalten);
      const x = 8 + ((spalte + 0.5) / spalten) * 84 + streuung(index) * 40;
      const y = 14 + ((zeile + 0.5) / zeilen) * 78 + streuung(index + 5) * 30;
    %>
    <%- include('notiz.ejs', {
      eintrag: eintrag,
      index: index,
      drehung: drehungen[index % drehungen.length],
      x: x,
      y: y
    }) %>
  <% }); %>

  <% if (eintraege.length === 0) { %>
    <p class="pinnwand-leer">
      Die Wand ist noch leer – klicke oben auf „Genesungswunsch wünschen“ und
      schreib den ersten Wunsch für Herrn Gerstgrasser auf.
    </p>
  <% } %>
</div>
